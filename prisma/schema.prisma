generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model users {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String            @unique @db.Citext
  first_name        String
  last_name         String            @default("")
  bio               String
  username          String            @unique @db.Citext
  gender            gender?
  phone             String?
  password          String
  avatar_id         String            @db.Uuid
  cover_id          String?           @db.Uuid
  email_verified_at DateTime?         @db.Timestamptz(6)
  google_id         String?           @unique
  last_seen_at      DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  uploaded_assets   assets[]          @relation("assets_uploaded_byTousers")
  memberships       chat_members[]
  created_chats     chats[]           @relation("chat_creator")
  received_requests friend_requests[] @relation("received_requests")
  sent_requests     friend_requests[] @relation("sent_requests")
  messages          messages[]
  reactions         message_reactions[]
  hidden_messages   message_hidden[]
  password_reset    password_resets?
  email_verification email_verifications?
  account_deletion  account_deletions?
  sessions          sessions[]
  push_subscriptions push_subscriptions[]
  notifications    notifications[]   @relation("notifications_user")
  caused_notifications notifications[] @relation("notifications_actor")
  avatar            assets            @relation("users_avatar_idToassets", fields: [avatar_id], references: [id], onUpdate: NoAction)
  cover             assets?           @relation("users_cover_idToassets", fields: [cover_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model notifications {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id    String    @db.Uuid
  actor_id   String?   @db.Uuid
  type       String
  title      String
  body       String    @default("")
  data       Json      @default("{}")
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       users     @relation("notifications_user", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor      users?    @relation("notifications_actor", fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)])
}

model sessions {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id      String   @db.Uuid
  browser      String?
  os           String?
  device_type  String?
  user_agent   String   @default("")
  ip           String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  push_subscriptions push_subscriptions[]
  user         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

model push_subscriptions {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id    String   @db.Uuid
  session_id String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session    sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([session_id])
}

model password_resets {
  user_id    String   @id @db.Uuid
  code_hash  String
  attempts   Int      @default(0)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model email_verifications {
  user_id    String   @id @db.Uuid
  code_hash  String
  attempts   Int      @default(0)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model account_deletions {
  user_id    String   @id @db.Uuid
  code_hash  String
  attempts   Int      @default(0)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chats {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String         @default("")
  avatar_id   String?        @db.Uuid
  group_chat  Boolean        @default(false)
  direct_key  String?        @unique
  disappearing_seconds Int?
  creator_id  String         @db.Uuid
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  members     chat_members[]
  invite      group_invites?
  avatar      assets?        @relation(fields: [avatar_id], references: [id], onUpdate: NoAction)
  creator     users          @relation("chat_creator", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages    messages[]
}

model chat_members {
  chat_id   String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamptz(6)
  last_read_at DateTime @default(now()) @db.Timestamptz(6)
  chat      chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([chat_id, user_id])
  @@index([user_id])
}

model group_invites {
  chat_id    String   @id @db.Uuid
  code       String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  chat       chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model messages {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  chat_id     String                @db.Uuid
  sender_id   String                @db.Uuid
  content     String                @default("")
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  forwarded   Boolean               @default(false)
  edited_at   DateTime?             @db.Timestamptz(6)
  deleted_at  DateTime?             @db.Timestamptz(6)
  reply_to_id String?               @db.Uuid
  link_preview Json?
  expires_at  DateTime?             @db.Timestamptz(6)
  attachments message_attachments[]
  reactions   message_reactions[]
  hidden_for  message_hidden[]
  chat        chats                 @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender      users                 @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reply_to    messages?             @relation("message_replies", fields: [reply_to_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies     messages[]            @relation("message_replies")

  @@index([chat_id, created_at(sort: Desc)])
  @@index([created_at])
  @@index([reply_to_id])
  @@index([expires_at])
}

model friend_requests {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sender_id   String         @db.Uuid
  receiver_id String         @db.Uuid
  status      request_status @default(pending)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  receiver    users          @relation("received_requests", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender      users          @relation("sent_requests", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sender_id, receiver_id])
  @@index([receiver_id, created_at(sort: Desc)])
}

model assets {
  id                  String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  public_id           String                @unique
  url                 String
  resource_type       String
  mime_type           String
  size_bytes          Int
  original_name       String
  uploaded_by         String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  uploader            users?                @relation("assets_uploaded_byTousers", fields: [uploaded_by], references: [id], onUpdate: NoAction)
  chat_avatars        chats[]
  message_attachments message_attachments[]
  user_avatars        users[]               @relation("users_avatar_idToassets")
  user_covers         users[]               @relation("users_cover_idToassets")

  @@index([uploaded_by])
}

model message_reactions {
  message_id String   @db.Uuid
  user_id    String   @db.Uuid
  emoji      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  message    messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([message_id, user_id])
  @@index([user_id])
}

model message_hidden {
  message_id String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  message    messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([message_id, user_id])
  @@index([user_id])
}

model message_attachments {
  message_id String   @db.Uuid
  asset_id   String   @db.Uuid
  position   Int
  asset      assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message    messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([message_id, asset_id])
  @@index([asset_id])
}

enum gender {
  male
  female
  other
  prefer_not_to_say
}

enum request_status {
  pending
  accepted
  rejected
}
