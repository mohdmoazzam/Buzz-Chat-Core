generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model users {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String            @unique @db.Citext
  first_name        String
  last_name         String            @default("")
  bio               String
  username          String            @unique @db.Citext
  gender            gender?
  phone             String?
  password          String
  avatar_id         String            @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  uploaded_assets   assets[]          @relation("assets_uploaded_byTousers")
  memberships       chat_members[]
  created_chats     chats[]           @relation("chat_creator")
  received_requests friend_requests[] @relation("received_requests")
  sent_requests     friend_requests[] @relation("sent_requests")
  messages          messages[]
  avatar            assets            @relation("users_avatar_idToassets", fields: [avatar_id], references: [id], onUpdate: NoAction)
}

model chats {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String         @default("")
  avatar_id   String?        @db.Uuid
  group_chat  Boolean        @default(false)
  direct_key  String?        @unique
  creator_id  String         @db.Uuid
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  members     chat_members[]
  avatar      assets?        @relation(fields: [avatar_id], references: [id], onUpdate: NoAction)
  creator     users          @relation("chat_creator", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages    messages[]
}

model chat_members {
  chat_id   String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamptz(6)
  chat      chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([chat_id, user_id])
  @@index([user_id])
}

model messages {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id     String                @db.Uuid
  sender_id   String                @db.Uuid
  content     String                @default("")
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  attachments message_attachments[]
  chat        chats                 @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender      users                 @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id, created_at(sort: Desc)])
  @@index([created_at])
}

model friend_requests {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String         @db.Uuid
  receiver_id String         @db.Uuid
  status      request_status @default(pending)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  receiver    users          @relation("received_requests", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender      users          @relation("sent_requests", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sender_id, receiver_id])
  @@index([receiver_id, created_at(sort: Desc)])
}

model assets {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id           String                @unique
  url                 String
  resource_type       String
  mime_type           String
  size_bytes          Int
  original_name       String
  uploaded_by         String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  uploader            users?                @relation("assets_uploaded_byTousers", fields: [uploaded_by], references: [id], onUpdate: NoAction)
  chat_avatars        chats[]
  message_attachments message_attachments[]
  user_avatars        users[]               @relation("users_avatar_idToassets")

  @@index([uploaded_by])
}

model message_attachments {
  message_id String   @db.Uuid
  asset_id   String   @db.Uuid
  position   Int
  asset      assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message    messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([message_id, asset_id])
  @@index([asset_id])
}

enum gender {
  male
  female
  other
  prefer_not_to_say
}

enum request_status {
  pending
  accepted
  rejected
}
