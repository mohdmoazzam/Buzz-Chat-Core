<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#f6f6f8;font-family:Arial,Helvetica,sans-serif;color:#222">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 12px">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:16px;overflow:hidden">
          <tr>
            <td style="background:linear-gradient(145deg,#ea7070 0%,#c94f7c 100%);background-color:#ea7070;padding:20px 28px">
              <a href="<%= app.url %>" style="color:#ffffff;font-size:20px;font-weight:700;text-decoration:none"><%= app.name %></a>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;font-size:15px;line-height:1.6">
              <%- content %>
            </td>
          </tr>
        </table>
        <p style="color:#999;font-size:12px;margin:16px 0 0">&copy; <%= app.year %> <%= app.name %></p>
      </td>
    </tr>
  </table>
</body>
</html>
