# Copy to .env and fill in. See docs/FEATURES.md ("Environment variables").

NODE_ENV=development
PORT=3000

# Neon Postgres: pooled URL for the app, direct URL for the Prisma CLI
DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
ADMIN_SECRET_KEY=

# Redis (BullMQ notification queues)
REDIS_URL=
# NOTIFICATION_WORKERS=false

# Brevo transactional email. The sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BuzzChat
# APP_URL=https://buzzchatapp.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extra CORS origins, comma separated
# CLIENT_URL=

# DEV ONLY: logs in as any user from localhost. Never set this on a deployed server.
# DEV_MASTER_PASSWORD=

# Sign in with Google: an OAuth "Web application" client id from Google Cloud Console (leave empty to turn it off)
GOOGLE_CLIENT_ID=
